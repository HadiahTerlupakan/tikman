VITE_API_URL=http://localhost:8080
VITE_APP_NAME=TikMan OLT Provisioning

# Firebase web config for push notifications. Public by Firebase's design, but
# kept out of the repository so the project can be rotated without a code
# change. Copy this file to .env (gitignored) and fill them in for local dev.
# Leave them blank and push notifications stay inert — the opt-in control is
# not even offered.
#
# In production these are NOT read from a file: docker-compose.yml passes them
# to the frontend image as build args, sourced from /opt/tikman/.env, because
# Vite inlines them at build time. Adding one here means adding it in
# frontend/Dockerfile and docker-compose.yml too.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
