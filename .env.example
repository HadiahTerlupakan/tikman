# Environment (development or production)
ENVIRONMENT=development

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=tikman
DB_PASSWORD=your-strong-password
POSTGRES_PASSWORD=your-strong-password
DB_NAME=tikman

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Security
# Generate with: openssl rand -hex 16 (for ENCRYPTION_KEY)
# Generate with: openssl rand -base64 32 (for SESSION_SECRET)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
SESSION_SECRET=your-session-secret

# API
API_PORT=8080
LOG_LEVEL=info

# CORS - Comma separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# WireGuard VPN
# UDP port published on the VPS host. It must equal the listen port saved on the
# VPN page and be open at the provider firewall, or no site can handshake.
WIREGUARD_PORT=51820

# Worker Polling Intervals (seconds)
POLLING_INTERVAL_ONT_STATUS=30
POLLING_INTERVAL_OLT_HEALTH=60
POLLING_INTERVAL_DISCOVERY=300

# Cloudflare Tunnel token for the VPS deployment, from the Zero Trust dashboard.
# The tunnel carries the web UI only; WIREGUARD_PORT still has to be reachable
# from the internet, because a site's UDP handshake cannot travel through it.
CLOUDFLARE_TUNNEL_TOKEN=

# CS WhatsApp module
WA_SEND_INTERVAL_MS=1200
WA_MEDIA_RETENTION_DAYS=90
# Where attachments are written. Both api and wa mount the cs_media volume
# here, and both write to it, so a change has to match docker-compose.yml.
WA_MEDIA_DIR=/data/cs-media
# How often the outbox is swept even when no Redis announcement arrives. It is
# the safety net under the announcement, not the normal path.
WA_DRAIN_INTERVAL_SECONDS=30

# Push notifications (Firebase Cloud Messaging).
#
# The secret half: base64-encoded service account JSON from Firebase Console >
# Project Settings > Service accounts > Generate new private key, on one line
# (`base64 -i sa.json | tr -d '\n'`). The api service reads it to send pushes.
# Empty disables push — the API still starts.
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
#
# The Realtime Database the presence mirror reads. The api service polls it;
# empty means presence is not mirrored, the same as an unconfigured project.
FIREBASE_DATABASE_URL=
#
# The public half: the web app config from Project Settings > General, and the
# VAPID key from Project Settings > Cloud Messaging > Web Push certificates.
# These are public by Firebase's design but live here rather than in the
# repository so the project can be rotated without a code change. Vite inlines
# them at build time, so docker-compose.yml passes them to the frontend image
# as build args — they are not runtime environment, and `up -d` alone will not
# pick up a change to them. Rebuild the frontend image after editing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_DATABASE_URL=
