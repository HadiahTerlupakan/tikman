FROM golang:1.25-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# The package, not one file: the worker is split across main.go, olt_poll.go and
# ont_poll.go, and naming a single file leaves the rest out and fails to build.
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o worker ./cmd/worker

FROM alpine:latest

RUN apk --no-cache add ca-certificates openssh-client

WORKDIR /root/

COPY --from=builder /app/worker .

CMD ["./worker"]
